{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 tools/restore_assets.py && python3 build.py",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/riposte-frontline.html"
    }
  ],
  "headers": [
    {
      "source": "/riposte-frontline.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://san-choi-9x.vercel.app http://localhost:2567"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}